# X (Twitter) - https://developer.twitter.com/en/portal/dashboard
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# LinkedIn - https://www.linkedin.com/developers/apps
# Requires scopes: w_member_social, r_liteprofile
LINKEDIN_ACCESS_TOKEN=

# Facebook Page - https://developers.facebook.com/apps
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Reddit - https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=social_post/1.0

# Buffer - https://buffer.com/developers/apps
# BUFFER_PROFILE_IDS: optional comma-separated list of profile IDs to target.
# Leave blank to post to all connected profiles.
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_IDS=
